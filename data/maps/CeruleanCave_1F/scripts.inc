CeruleanCave_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, CeruleanCave_1F_OnTransition
	.byte 0

CeruleanCave_1F_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_CERULEAN_CAVE_1F
	end

CeruleanCave_1F_EventScript_GiovanniTrigger_Center::
	lockall
	goto_if_set FLAG_HIDE_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_EventScript_GiovanniTriggerEnd
	setvar VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 1
	playse SE_PIN
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, Common_Movement_ExclamationMark
	waitmovement 0
	waitse
	delay 30
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniApproach_Center
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniConfront
	end

CeruleanCave_1F_EventScript_GiovanniTrigger_Left::
	lockall
	goto_if_set FLAG_HIDE_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_EventScript_GiovanniTriggerEnd
	setvar VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 2
	playse SE_PIN
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, Common_Movement_ExclamationMark
	waitmovement 0
	waitse
	delay 30
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniApproach_Left
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniConfront
	end

CeruleanCave_1F_EventScript_GiovanniTrigger_Right::
	lockall
	goto_if_set FLAG_HIDE_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_EventScript_GiovanniTriggerEnd
	setvar VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 3
	playse SE_PIN
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, Common_Movement_ExclamationMark
	waitmovement 0
	waitse
	delay 30
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniApproach_Right
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniConfront
	end

CeruleanCave_1F_EventScript_GiovanniConfront::
	msgbox CeruleanCave_1F_Text_GiovanniIntro, MSGBOX_DEFAULT
	closemessage
	trainerbattle_no_intro TRAINER_BOSS_GIOVANNI_3, CeruleanCave_1F_Text_GiovanniDefeat
	msgbox CeruleanCave_1F_Text_GiovanniFarewell, MSGBOX_DEFAULT
	closemessage
	compare VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 1
	goto_if_eq CeruleanCave_1F_EventScript_GiovanniLeave_Center
	compare VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 2
	goto_if_eq CeruleanCave_1F_EventScript_GiovanniLeave_Left
	compare VAR_MAP_SCENE_GIOVANNI_CERULEAN_CAVE, 3
	goto_if_eq CeruleanCave_1F_EventScript_GiovanniLeave_Right
	end

CeruleanCave_1F_EventScript_GiovanniLeave_Center::
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniLeave_Center
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniDisappear

CeruleanCave_1F_EventScript_GiovanniLeave_Left::
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniLeave_Left
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniDisappear

CeruleanCave_1F_EventScript_GiovanniLeave_Right::
	applymovement LOCALID_CERULEAN_CAVE_GIOVANNI, CeruleanCave_1F_Movement_GiovanniLeave_Right
	waitmovement 0
	goto CeruleanCave_1F_EventScript_GiovanniDisappear

CeruleanCave_1F_EventScript_GiovanniDisappear::
	playse SE_EXIT
	setflag FLAG_HIDE_CERULEAN_CAVE_GIOVANNI
	setflag FLAG_DEFEATED_BOSS_GIOVANNI
	removeobject LOCALID_CERULEAN_CAVE_GIOVANNI

CeruleanCave_1F_EventScript_GiovanniTriggerEnd::
	releaseall
	end

CeruleanCave_1F_EventScript_Giovanni::
	lock
	faceplayer
	msgbox CeruleanCave_1F_Text_GiovanniIntro, MSGBOX_DEFAULT
	release
	end

CeruleanCave_1F_Movement_GiovanniApproach_Center:
	walk_down
	walk_down
	step_end

CeruleanCave_1F_Movement_GiovanniApproach_Left:
	walk_down
	walk_down
	walk_left
	face_down
	step_end

CeruleanCave_1F_Movement_GiovanniApproach_Right:
	walk_down
	walk_down
	walk_right
	face_down
	step_end

CeruleanCave_1F_Movement_GiovanniLeave_Center:
	walk_left
	walk_down
	walk_down
	walk_right
	face_down
	delay_16
	set_invisible
	step_end

CeruleanCave_1F_Movement_GiovanniLeave_Left:
	walk_right
	walk_down
	walk_down
	set_invisible
	step_end

CeruleanCave_1F_Movement_GiovanniLeave_Right:
	walk_left
	walk_down
	walk_down
	set_invisible
	step_end
