CeruleanCave_1F_Text_GiovanniIntro::
	.string "You. Of all people.\p"
	.string "I should have known you would\n"
	.string "find your way here too.\p"
	.string "I have hunted this creature since\n"
	.string "it tore free of Cinnabar.\p"
	.string "The Silph Scope, the Master Ball…\n"
	.string "Each time, you stood in my way.\p"
	.string "No longer.\p"
	.string "If this weapon cannot be mine,\n"
	.string "then no one shall reach it.\p"
	.string "I will end this here.$"

CeruleanCave_1F_Text_GiovanniDefeat::
	.string "…Again. Always you.$"

CeruleanCave_1F_Text_GiovanniFarewell::
	.string "It is over.\p"
	.string "I will not chase this creature\n"
	.string "any further.\p"
	.string "Perhaps it is fitting\n"
	.string "that the beast falls to you now…$"

CeruleanCave_1F_Text_GiovanniTakeThis::
	.string "Take this.$"

CeruleanCave_1F_Text_ObtainedCatchingCharm::
	.string "{PLAYER} received the Catching\n"
	.string "Charm from Giovanni.$"

CeruleanCave_1F_Text_GiovanniCatchingCharm::
	.string "The creature is your burden now…\p"
	.string "A burden for someone who lacks\n"
	.string "what it takes to make it a weapon.$"
