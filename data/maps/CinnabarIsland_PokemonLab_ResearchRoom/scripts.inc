CinnabarIsland_PokemonLab_ResearchRoom_MapScripts::
	.byte 0

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor::
	goto EventScript_MetronomeTutor
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Scientist::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_EeveeCanEvolveIntroThreeMons, MSGBOX_NPC
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Computer::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_LegendaryBirdEmail, MSGBOX_SIGN
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_AmberPipe::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_AnAmberPipe, MSGBOX_SIGN
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher::
	lock
	faceplayer
	setmoverelearnerstate MOVE_RELEARNER_EGG_MOVES
	goto_if_set FLAG_EGG_TUTOR_INTRODUCED, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Returning
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_WelcomeEggMoveTeacher, MSGBOX_YESNO
	setflag FLAG_EGG_TUTOR_INTRODUCED
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Decline
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Returning::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_ReturningPlayer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Decline
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu::
	checkmoney 10000, 0
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_NoMoney
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_ChoosePokemon
	special ChooseMonForMoveRelearner
	waitstate
	goto_if_ge VAR_0x8004, PARTY_SIZE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Decline
	special IsSelectedMonEgg
	goto_if_eq VAR_RESULT, TRUE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_IsEgg
	special HasMovesToRelearn
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_NoMoves
	special TeachMoveRelearnerMove
	waitstate
	goto_if_eq VAR_0x8004, 0, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	removemoney 10000, 0
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Success
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Success::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_MoveTaughtSuccess, MSGBOX_DEFAULT
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_AnotherPokemon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_FarewellAfterService
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_IsEgg::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_CantTeachEgg
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_NoMoves::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_NoEggMovesToTeach
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_PartyMenu
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_Decline::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_ComeBackAnytime
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_FarewellAfterService::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FarewellAfterService
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_EggMoveTeacher_NoMoney::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_NotEnoughMoney
	release
	end
