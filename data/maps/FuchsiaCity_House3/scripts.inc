FuchsiaCity_House3_MapScripts::
	.byte 0

FuchsiaCity_House3_EventScript_MoveDeleter::
	lock
	faceplayer
	msgbox FuchsiaCity_House3_Text_WouldYouLikeToForgetMove, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FuchsiaCity_House3_EventScript_ChooseMonForMoveDeleter
	goto FuchsiaCity_House3_EventScript_CancelForgetMove
	end

FuchsiaCity_House3_EventScript_ChooseMonForMoveDeleter::
	msgbox FuchsiaCity_House3_Text_WhichMonShouldForgetMove
	special ChoosePartyMon
	waitstate
	goto_if_ge VAR_0x8004, PARTY_SIZE, FuchsiaCity_House3_EventScript_CancelForgetMove
	special IsSelectedMonEgg
	goto_if_eq VAR_RESULT, TRUE, FuchsiaCity_House3_EventScript_CantForgetMoveEgg
	special GetNumMovesSelectedMonHas
	goto_if_eq VAR_RESULT, 1, FuchsiaCity_House3_EventScript_CantForgetOnlyMove
	msgbox FuchsiaCity_House3_Text_WhichMoveShouldBeForgotten
	fadescreen FADE_TO_BLACK
	special SelectMoveDeleterMove
	fadescreen FADE_FROM_BLACK
	goto_if_eq VAR_0x8005, MAX_MON_MOVES, FuchsiaCity_House3_EventScript_ChooseMonForMoveDeleter
	special BufferMoveDeleterNicknameAndMove
	msgbox FuchsiaCity_House3_Text_MonsMoveShouldBeForgotten, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FuchsiaCity_House3_EventScript_ForgetMove
	goto FuchsiaCity_House3_EventScript_CancelForgetMove
	end

FuchsiaCity_House3_EventScript_ForgetMove::
	special MoveDeleterForgetMove
	playfanfare MUS_MOVE_DELETED
	waitfanfare
	msgbox FuchsiaCity_House3_Text_MonHasForgottenMoveCompletely
	release
	end

FuchsiaCity_House3_EventScript_CantForgetOnlyMove::
	special BufferMoveDeleterNicknameAndMove
	msgbox FuchsiaCity_House3_Text_MonOnlyKnowsOneMove
	release
	end

FuchsiaCity_House3_EventScript_CantForgetMoveEgg::
	msgbox FuchsiaCity_House3_Text_NoEggShouldKnowMoves
	release
	end

FuchsiaCity_House3_EventScript_CancelForgetMove::
	msgbox FuchsiaCity_House3_Text_ComeAgainToForgetOtherMoves
	release
	end

Fuchsia_House_EventScript_MoveManiac::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lock
	faceplayer
	clearflag HAS_BIG_MUSHROOM
	clearflag HAS_TINY_MUSHROOMS
	clearflag HAS_BOTH_MUSHROOMS
	goto_if_set CHECKED_MUSHROOMS, Fuchsia_House_EventScript_CheckPlayerHasMushrooms
	msgbox Fuchsia_House_Text_TeachMonMoveForMushroom
	setflag CHECKED_MUSHROOMS
	goto Fuchsia_House_EventScript_CheckPlayerHasMushrooms
	end

Fuchsia_House_EventScript_CheckPlayerHasMushrooms::
	checkitem ITEM_BIG_MUSHROOM
	call_if_eq VAR_RESULT, TRUE, Fuchsia_House_EventScript_SetHasBigMushroom
	checkitem ITEM_TINY_MUSHROOM, 2
	call_if_eq VAR_RESULT, TRUE, Fuchsia_House_EventScript_SetHasTinyMushrooms
	goto_if_set HAS_BIG_MUSHROOM, Fuchsia_House_EventScript_CheckAlsoHasTinyMushrooms
	goto_if_set HAS_TINY_MUSHROOMS, Fuchsia_House_EventScript_CheckAlsoHasBigMushroom
	goto Fuchsia_House_EventScript_EndTutorMove
	end

Fuchsia_House_EventScript_CheckAlsoHasTinyMushrooms::
	call_if_set HAS_TINY_MUSHROOMS, Fuchsia_House_EventScript_SetHasBothMushrooms
	goto Fuchsia_House_EventScript_AskTutorMon
	end

Fuchsia_House_EventScript_CheckAlsoHasBigMushroom::
	call_if_set HAS_BIG_MUSHROOM, Fuchsia_House_EventScript_SetHasBothMushrooms
	goto Fuchsia_House_EventScript_AskTutorMon
	end

Fuchsia_House_EventScript_AskTutorMon::
	msgbox Fuchsia_House_Text_WantMeToTeachMove, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Fuchsia_House_EventScript_EndTutorMove
	goto Fuchsia_House_EventScript_ChooseMonToTutor
	end

Fuchsia_House_EventScript_ChooseMonToTutor::
	msgbox Fuchsia_House_Text_TutorWhichMon
	special ChooseMonForMoveRelearner
	waitstate
	goto_if_ge VAR_0x8004, PARTY_SIZE, Fuchsia_House_EventScript_EndTutorMove
	special IsSelectedMonEgg
	goto_if_eq VAR_RESULT, TRUE, Fuchsia_House_EventScript_CantTutorEgg
	special HasMovesToRelearn
	goto_if_eq VAR_RESULT, 0, Fuchsia_House_EventScript_NoMoveToTutorMon
	goto Fuchsia_House_EventScript_ChooseMoveToTeach
	end

Fuchsia_House_EventScript_ChooseMoveToTeach::
	msgbox Fuchsia_House_Text_TeachWhichMove
	special TeachMoveRelearnerMove
	waitstate
	goto_if_eq VAR_0x8004, 0, Fuchsia_House_EventScript_ChooseMonToTutor
	goto_if_set HAS_BOTH_MUSHROOMS, Fuchsia_House_EventScript_ChooseMushroom
	goto_if_set HAS_BIG_MUSHROOM, Fuchsia_House_EventScript_GiveBigMushroom
	goto_if_set HAS_TINY_MUSHROOMS, Fuchsia_House_EventScript_GiveTinyMushrooms
	end

Fuchsia_House_EventScript_GiveBigMushroom::
	removeitem ITEM_BIG_MUSHROOM
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox Fuchsia_House_Text_HandedOverOneBigMushroom
	call EventScript_RestorePrevTextColor
	goto Fuchsia_House_EventScript_EndTutorMove
	end

Fuchsia_House_EventScript_GiveTinyMushrooms::
	removeitem ITEM_TINY_MUSHROOM, 2
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox Fuchsia_House_Text_HandedOverTwoTinyMushrooms
	call EventScript_RestorePrevTextColor
	goto Fuchsia_House_EventScript_EndTutorMove
	end

Fuchsia_House_EventScript_ChooseMushroom::
	message Fuchsia_House_Text_IllNeedMushroomOrTwo
	waitmessage
	multichoice 0, 0, MULTI_MUSHROOMS, TRUE
	switch VAR_RESULT
	case 0, Fuchsia_House_EventScript_GiveTinyMushrooms
	case 1, Fuchsia_House_EventScript_GiveBigMushroom
	end

Fuchsia_House_EventScript_NoMoveToTutorMon::
	msgbox Fuchsia_House_Text_NoMoveICanTeachThatMon
	goto Fuchsia_House_EventScript_ChooseMonToTutor
	end

Fuchsia_House_EventScript_CantTutorEgg::
	msgbox Fuchsia_House_Text_CantTeachAnEgg
	goto Fuchsia_House_EventScript_ChooseMonToTutor
	end

Fuchsia_House_EventScript_EndTutorMove::
	msgbox Fuchsia_House_Text_NeedMushroomOrTwoToLearnMove
	release
	end

Fuchsia_House_EventScript_SetHasBigMushroom::
	setflag HAS_BIG_MUSHROOM
	return

Fuchsia_House_EventScript_SetHasTinyMushrooms::
	setflag HAS_TINY_MUSHROOMS
	return

Fuchsia_House_EventScript_SetHasBothMushrooms::
	setflag HAS_BOTH_MUSHROOMS
	return
