SaffronCity_MrPsychicsHouse_MapScripts::
	.byte 0

SaffronCity_MrPsychicsHouse_EventScript_MrPsychic::
	lock
	faceplayer
	goto_if_set FLAG_GOT_TM29_FROM_MR_PSYCHIC, SaffronCity_MrPsychicsHouse_EventScript_AlreadyGotItem
	
	msgbox SaffronCity_MrPsychicsHouse_Text_YouWantedThese
	
	checkitemspace ITEM_TM29, 1
	goto_if_eq VAR_RESULT, FALSE, SaffronCity_MrPsychicsHouse_EventScript_NoRoom
	checkitemspace ITEM_TWISTED_SPOON, 1
	goto_if_eq VAR_RESULT, FALSE, SaffronCity_MrPsychicsHouse_EventScript_NoRoom
	
	giveitem_msg SaffronCity_MrPsychicsHouse_Text_ReceivedItemsFromMrPsychic, ITEM_TM29
	giveitem ITEM_TWISTED_SPOON
	
	msgbox SaffronCity_MrPsychicsHouse_Text_ExplainBoth
	setflag FLAG_GOT_TM29_FROM_MR_PSYCHIC
	release
	end

SaffronCity_MrPsychicsHouse_EventScript_NoRoom::
	msgbox SaffronCity_MrPsychicsHouse_Text_YouveNoRoom
	release
	end

SaffronCity_MrPsychicsHouse_EventScript_AlreadyGotItem::
	msgbox SaffronCity_MrPsychicsHouse_Text_ExplainBoth
	release
	end
